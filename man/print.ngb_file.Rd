\name{print.ngb_file}
\alias{print.ngb_file}
\title{Print an NGB File Summary}
\usage{\method{print}{ngb_file}(x, ...)}
\arguments{
\item{x}{An object returned by \code{read_ngb}.}
\item{...}{Unused additional arguments.}
}
\description{Displays measurement kind, sample name, channel count and run lengths.}
\value{Returns \code{x} invisibly.}
